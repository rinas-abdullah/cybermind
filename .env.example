# =====================================================
# رِسَاق (Risaq) Environment Configuration
# Copy this file to .env and update values as needed
# =====================================================

# ===== SERVER CONFIGURATION =====
PORT=3001
HOST=127.0.0.1
NODE_ENV=development
TRUST_PROXY=false

# ===== LOCAL / CUSTOM DOMAIN (دومين محلي أو عنوانك العام) =====
# اسم مضيف محلي (يُضاف إلى ملف hosts ليشير إلى 127.0.0.1)
LOCAL_DOMAIN=risaq.local
# عنوان التطبيق العام (يُضاف تلقائياً إلى CORS كـ origin)
# مثال بعد إعداد hosts وتشغيل السيرفر على PORT:
SITE_URL=http://risaq.local:3001
# عند استخدام اسم مضيف مخصص، غالباً تحتاج الاستماع على كل الواجهات:
# HOST=0.0.0.0

# ===== DATABASE CONFIGURATION =====
# Only two modes are actually implemented (backend/db.js): in-memory | postgresql
# in-memory needs zero setup (auth + a couple of demo accounts work out of the
# box) but nothing persists across restarts and features needing real
# relational tables (paths/modules/tasks, analytics, technical resumes) are
# disabled. Use postgresql for anything beyond a quick trial.
DB_TYPE=in-memory

# PostgreSQL Configuration (required when DB_TYPE=postgresql)
DATABASE_URL=postgresql://postgres:password@localhost:5432/risaq

# ===== SECURITY CONFIGURATION =====
# IMPORTANT: Change these values in production!
JWT_SECRET=risaq-dev-secret-key-256bit-change-in-production-12345
JWT_EXPIRES_IN=24h

# ===== CORS CONFIGURATION =====
CORS_ORIGIN=http://127.0.0.1:3001,http://localhost:3001,http://127.0.0.1:5500,http://localhost:5500
CORS_CREDENTIALS=true

# ===== AI/ML CONFIGURATION =====
# Leave as the placeholder below to run on the built-in mock AI mentor
# (bilingual EN/AR, no external calls). Set a real key to use OpenAI instead.
OPENAI_API_KEY=sk-your-openai-api-key-here

# ===== LOGGING CONFIGURATION =====
LOG_LEVEL=debug

# ===== RATE LIMITING =====
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
