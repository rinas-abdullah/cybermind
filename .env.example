# =====================================================
# CyberMind Environment Configuration
# Copy this file to .env and update values as needed
# =====================================================

# ===== SERVER CONFIGURATION =====
PORT=3001
HOST=127.0.0.1
NODE_ENV=development
TRUST_PROXY=false

# ===== LOCAL / CUSTOM DOMAIN (دومين محلي أو عنوانك العام) =====
# اسم مضيف محلي (يُضاف إلى ملف hosts ليشير إلى 127.0.0.1)
LOCAL_DOMAIN=cybermind.local
# عنوان التطبيق العام (يُضاف تلقائياً إلى CORS كـ origin)
# مثال بعد إعداد hosts وتشغيل السيرفر على PORT:
SITE_URL=http://cybermind.local:3001
# عند استخدام اسم مضيف مخصص، غالباً تحتاج الاستماع على كل الواجهات:
# HOST=0.0.0.0

# ===== DATABASE CONFIGURATION =====
# Supported by backend/config/environment.js: in-memory | postgresql
DB_TYPE=in-memory

# PostgreSQL Configuration (if DB_TYPE=postgresql or postgres)
DATABASE_URL=postgresql://postgres:password@localhost:5432/cybermind

# MongoDB Configuration (if DB_TYPE=mongodb)
MONGODB_URI=mongodb://localhost:27017/cybermind

# MySQL Configuration (if DB_TYPE=mysql)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=cybermind

# ===== SECURITY CONFIGURATION =====
# IMPORTANT: Change these values in production!
JWT_SECRET=cybermind-dev-secret-key-256bit-change-in-production-12345
JWT_EXPIRES_IN=24h

# ===== CORS CONFIGURATION =====
CORS_ORIGIN=http://127.0.0.1:3001,http://localhost:3001,http://127.0.0.1:5500,http://localhost:5500
CORS_CREDENTIALS=true

# ===== AI/ML CONFIGURATION =====
OPENAI_API_KEY=sk-your-openai-api-key-here

# ===== LOGGING CONFIGURATION =====
LOG_LEVEL=debug

# ===== RATE LIMITING =====
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
